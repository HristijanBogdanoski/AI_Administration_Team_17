POSTGRESQL_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/ai_administration
USE_SQLITE=false
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Main Admin
ADMIN_PASSWORD=admin1234
ADMIN_FORCE_PASSWORD_UPDATE=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
TAVILY_API_KEY=your_tavily_key_here
TAVILY_MAX_RESULTS=3
TAVILY_SEARCH_DEPTH=basic
TAVILY_INCLUDE_DOMAINS=gov.mk,mvr.gov.mk,ujp.gov.mk,mtsp.gov.mk,mioa.gov.mk,uslugi.gov.mk,katastar.gov.mk,fzo.org.mk,av.gov.mk
TAVILY_STRICT_SOURCES=true

